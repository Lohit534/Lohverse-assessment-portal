# Flask environment
FLASK_DEBUG=true

# Database (PostgreSQL / Neon / Render)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Security — change these in production!
JWT_SECRET_KEY=enter ur key
SECRET_KEY=enter ur key

# Frontend URLs for dynamic Flask-CORS (comma-separated)
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# Cloudinary Resume Storage API Keys
CLOUDINARY_CLOUD_NAME=enter cloud name
CLOUDINARY_API_KEY=enter api key
CLOUDINARY_API_SECRET=enter api secret

# ── AI API Keys ──────────────────────────────────────────────
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=enter ur key

# ── Compiler API Keys (Optional) ──────────────────────────────
# Obtain a key from RapidAPI for online compilations: https://rapidapi.com/judge0/api/judge0-ce
# Note: If left blank, the platform automatically falls back to secure local run subprocesses.
JUDGE0_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
